{
  "name": "orkami",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Origami for the web: a fold engine that lets blocks of a page unfold out of their background like real paper, with CSS and WebGL drivers and a Vue adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maslach-llc/orkami.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "import": "./dist/css/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./orkami.css": "./dist/orkami.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-vue.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
